{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "jsx": "react-jsx",
    "allowJs": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "typeRoots": ["src/types", "node_modules/@types"],
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "storybook-static", "node_modules"]
}
